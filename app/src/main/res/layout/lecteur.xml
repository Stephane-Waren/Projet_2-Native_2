<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarLecteur"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/black"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/white"
        app:title="Lecteur Multimedia"
        app:titleTextColor="@color/white" />

    <FrameLayout
        android:id="@+id/conteneur"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#422C2C">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:use_controller="false" />

        <Button
            android:id="@+id/boutonPleinEcran"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:text="Plein Ecran" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/boutonArretez"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginHorizontal="6dp"
            android:background="@color/white"
            android:contentDescription="bouton Arretez"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_stop_24" />

        <ImageButton
            android:id="@+id/boutonReculer"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginHorizontal="6dp"
            android:background="@color/white"
            android:contentDescription="bouton Reculer"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_replay_10_24" />

        <ImageButton
            android:id="@+id/boutonPlay"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginHorizontal="6dp"
            android:background="@color/white"
            android:contentDescription="Play"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_play_arrow_24" />

        <ImageButton
            android:id="@+id/boutonAvancer"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginHorizontal="6dp"
            android:background="@color/white"
            android:contentDescription="bouton Avancer"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_forward_10_24" />

        <ImageButton
            android:id="@+id/boutonRejouer"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginHorizontal="6dp"
            android:background="@color/white"
            android:contentDescription="bouton Rejouer"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_repeat_24" />

    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/boutonVeille"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Garder l'écran allumé"
        android:textColor="@color/white" />

</LinearLayout>


